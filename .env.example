# ---- Required ----
# From @BotFather -> /newbot
BOT_TOKEN=

# OpenAI-compatible API key. Works with OpenAI, OpenRouter, or any OpenAI-compatible
# gateway (set OPENAI_BASE_URL below to use a different provider).
OPENAI_API_KEY=

# Telegram user ID of the business owner (the person whose DMs the bot answers).
# Get yours from @userinfobot. Only this account can control the bot.
OWNER_CHAT_ID=

# ---- Business connection ----
# The business_connection_id of the Telegram Business account to serve.
# Leave EMPTY to auto-attach to the first Business account that connects the bot.
BUSINESS_CONNECTION_ID=

# ---- Behaviour ----
# draft = every AI reply goes to OWNER_CHAT_ID for Approve / Edit / Regenerate / Discard
# auto  = AI replies are sent to customers immediately, and a copy is logged to the owner
MODE=draft

# ---- Server ----
PORT=3000
# Public URL of this server, e.g. https://secretary.example.com
# If empty, the bot runs in long-polling mode instead of webhooks (good for local dev).
WEBHOOK_URL=
# Optional secret token Telegram sends with every webhook update
WEBHOOK_SECRET=

# ---- AI provider (optional overrides) ----
# Example for OpenRouter: https://openrouter.ai/api/v1
OPENAI_BASE_URL=
MODEL=

# ---- Tuning (optional) ----
AUTO_MAX_CHARS=800
HISTORY_LIMIT=10
DB_PATH=./data/secretary.db
